# ─── Provider selection ───────────────────────────────────────────────────────
# Which LLM backend to use. If omitted, the app will ask you interactively.
# Options: anthropic | openai | gemini | ollama | openrouter | openai-compatible
LLM_PROVIDER=anthropic

# ─── Anthropic / Claude ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── OpenAI / GPT ─────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ─── Google Gemini ────────────────────────────────────────────────────────────
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# ─── Ollama (local, no key needed) ────────────────────────────────────────────
# OLLAMA_MODEL=llama3.2

# ─── OpenRouter (access 100+ models via one API) ─────────────────────────────
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o   # or anthropic/claude-3-5-sonnet, etc.

# ─── Any OpenAI-compatible endpoint ──────────────────────────────────────────
# LLM_PROVIDER=openai-compatible
# OPENAI_API_KEY=...
# OPENAI_MODEL=...
# OPENAI_BASE_URL=https://your-endpoint/v1

# ─── App ──────────────────────────────────────────────────────────────────────
# USE_UV=1   # set to 1 if you want the MCP server spawned via `uv run`
